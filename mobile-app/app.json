{
  "expo": {
    "name": "Vistaar Flow",
    "slug": "crm-agent-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#062a29"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techoceanhub.crmagent"
    },
    "android": {
      "package": "com.techoceanhub.vistaarflow",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [ 
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#003b85"
        }
      ]
    ],
    "web": {},
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#003b85"
    },
    "extra": {
      "eas": {
        "projectId": "55d24b42-c9b8-491e-b540-711661360ed2"
      }
    }
  }
}
