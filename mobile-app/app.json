{
  "expo": {
    "name": "CRM Agent",
    "slug": "crm-agent-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f766e"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techoceanhub.crmagent"
    },

    "android": {
      "package": "com.crmagent",
      "googleServicesFile": "./google-services.json"
    },

    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0f766e",
          "androidMode": "default",
          "androidCollapsedTitle": "CRM Agent",
          "iosDisplayInForeground": true
        }
      ]
    ],

    "web": {},

    "extra": {
      "eas": {
        "projectId": "b76117df-ae59-42ab-a8f1-ad119b9ff181"
      }
    }
  }
}
